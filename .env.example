EXPO_PUBLIC_API_URL=http://localhost:3005/api

# Sentry DSN is safe to bundle into the client (that's how Sentry's DSN is designed to be used) -
# leave empty to run with Sentry disabled. Do NOT put SENTRY_AUTH_TOKEN, SENTRY_ORG, or
# SENTRY_PROJECT here - those are build-time-only secrets for source-map/dSYM upload and must
# only exist as EAS secrets/CI environment variables, never in a committed .env file.
EXPO_PUBLIC_SENTRY_DSN=
# Optional: only needed to point non-production builds at a distinct Sentry environment (e.g.
# "staging"/"preview"). Defaults to "development" locally, "production" otherwise.
EXPO_PUBLIC_SENTRY_ENVIRONMENT=
# Optional dev-only opt-in: set to "true" locally to actually send events to Sentry while testing
# this integration itself. Leave unset otherwise - development is disabled by default.
EXPO_PUBLIC_SENTRY_ENABLE_DEV=
